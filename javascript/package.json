{
  "name": "hyperswitch-prism-workshop-js",
  "version": "1.0.0",
  "description": "Hands-on workshop for hyperswitch-prism (JavaScript/TypeScript SDK): run a payment with one PSP, switch PSPs with a one-line change, build a payment orchestrator (routing + retry), extend a flow/processor, and run a test suite.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "run:payment": "tsx src/steps/step1-run-payment.ts",
    "run:routing": "tsx src/steps/step2-routing.ts",
    "run:retry": "tsx src/steps/step3-retry.ts",
    "run:extend": "tsx src/steps/step4-extend.ts",
    "web": "tsx watch web/server/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "hyperswitch-prism": "^0.2.0",
    "undici": "^6.23.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
