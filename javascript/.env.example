# ─────────────────────────────────────────────────────────────────────────────
# Workshop credentials — copy this file to ".env" and fill in your SANDBOX keys.
#
#   cp .env.example .env
#
# You only need credentials for the PSPs you actually want to call. The demos
# degrade gracefully: if a PSP has no credentials, the SDK still builds and
# sends the request, and you'll see a clear connector error instead of a charge.
# The test suite (npm test) needs NO credentials at all.
# ─────────────────────────────────────────────────────────────────────────────

# PSP-1 — Stripe (single API key)
STRIPE_API_KEY=sk_test_your_stripe_secret_key

# PSP-2 — Adyen (API key + merchant account)
ADYEN_API_KEY=your_adyen_api_key
ADYEN_MERCHANT_ACCOUNT=your_adyen_merchant_account

# PSP-3 — Cybersource (used in the "add a processor" extension, step 7)
CYBERSOURCE_API_KEY=your_cybersource_api_key
CYBERSOURCE_MERCHANT_ACCOUNT=your_cybersource_merchant_account
CYBERSOURCE_API_SECRET=your_cybersource_api_secret

# ─────────────────────────────────────────────────────────────────────────────
# WEB EXPERIENCE (npm run web) — extra keys for the browser-tokenized (PCI) path
# ─────────────────────────────────────────────────────────────────────────────
# The store's raw-card (non-PCI) mode needs only the server keys above. The
# PCI/tokenized mode additionally needs each connector's CLIENT-side key so its
# SDK can run in the browser and tokenize the card in hosted fields.

# PSP-4 — GlobalPay (appId + appKey; used by the web store's PCI checkout)
GLOBALPAY_APP_ID=your_globalpay_app_id
GLOBALPAY_APP_KEY=your_globalpay_app_key

# Stripe publishable key (browser-side, for Stripe Payment Element)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Adyen client key (browser-side, for Adyen web components)
ADYEN_CLIENT_KEY=test_your_adyen_client_key

# Web server (optional overrides)
PORT=3000
BASE_URL=http://localhost:3000

# Structured server logging (npm run web)
#   LOG_LEVEL  = debug | info | warn | error   (default: debug — verbose, great for the workshop)
#   LOG_FORMAT = pretty | json                 (default: pretty; use json for machine-readable logs)
LOG_LEVEL=debug
LOG_FORMAT=pretty
